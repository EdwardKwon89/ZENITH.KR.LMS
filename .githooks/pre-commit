#!/bin/bash
# ZENITH_LMS — Pre-commit Gate
# R-08: 회귀 테스트 통과 필수 (R-01 에이전트 태그는 commit-msg 훅에서 검증)
# R-17 v3.0(2026-08-14): Task 상태는 GitHub Issue 라벨로 관리 — .agent/ACTIVE_TASK.md는
# GitHub Action 전용 자동 미러이므로 Agent 커밋에 동봉할 대상이 아니다.

set -e

# ── R-08: 회귀 테스트 결과 확인 (경고만, 병합 판단은 원격 CI 전용 — Issue #358) ──
# 자체보고 파일(LAST_REGRESSION_RESULT)과 실제 회귀 결과 불일치(IMP-135)가 반복 확인되어
# 이 파일을 커밋 차단 근거로 더 이상 사용하지 않는다. 실제 통과 여부는 반드시
# GitHub Actions "PR Checks"(gh pr checks)로 확인한다 — 이 경고는 참고용일 뿐이다.
REGRESSION_FILE=".agent/LAST_REGRESSION_RESULT"

if [ -f "$REGRESSION_FILE" ]; then
  RESULT=$(cat "$REGRESSION_FILE" | tr -d '[:space:]')
  if [ "$RESULT" != "PASS" ]; then
    echo ""
    echo "⚠️  참고: LAST_REGRESSION_RESULT = $RESULT (커밋 차단 안 함)"
    echo "   실제 통과 여부는 병합 전 'gh pr checks'로 반드시 확인하십시오."
    echo ""
  fi
fi

# ── R-17: GitHub Issue 라벨 갱신 리마인더 ─────────────────────────
# Task 상세 파일 변경 시 GitHub Issue 라벨(status:in-progress/review 등) 갱신을 잊지 않도록 안내
TASK_FILES=$(git diff --cached --name-only | grep "^\.agent/tasks/TASK-" || true)

if [ -n "$TASK_FILES" ]; then
  echo ""
  echo "ℹ️  참고: Task 상세 파일 변경분이 있습니다 — GitHub Issue 라벨(status:*) 갱신을 잊지 마십시오 (R-17 v3.0)."
  echo "   변경된 Task 파일:"
  echo "$TASK_FILES" | sed 's/^/     /'
  echo ""
fi

echo "✅ Pre-commit 게이트 통과 — 커밋 진행"
exit 0
