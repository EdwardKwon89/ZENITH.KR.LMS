# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.aws/
.ups_shxk_prod_keys/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mcp configuration & specific settings
.claude/

# ─── Temporary DB Dumps (do not commit) ───────────────────
db_dump*.sql
db_data*.sql
scratch_*.sql
_temp_*.sql
_tmp_*.sql

# ─── Temporary Python Scripts ─────────────────────────────
scratch_*.py
_temp_*.py
_tmp_*.py

# ─── Obsidian Vault ───────────────────────────────────────
.obsidian/workspace.json
.obsidian/workspace-mobile.json

test-results/

# ─── Temporary Log Files ────────────────────────────────
scratch/

# ─── Local-only SaaS credential notes (never commit) ───────
.logSaaS/

# Sentry Config File
.env.sentry-build-plugin

# ─── R-10 검증용 임시 Playwright config (PLAYWRIGHT_PORT env var 사용 권장, /tmp에 둘 것) ───
playwright.r10*.config.ts
playwright*.local.config.ts

# ─── orchestration: Edward 로컬 도구(에이전트 상호 검토 호출기) — 저장소 미포함(Edward 결정 2026-11-13). 확정 보고서는 docs/08_Self_Audit/Reviews/ 로 복사 ───
orchestration/

# ─── 폐지된 자체보고 파일(IMP-135, 2026-11-14): 에이전트 문서·구 훅이 재생성해도 커밋되지 않도록 무시 ───
.agent/LAST_REGRESSION_RESULT

# ─── TASK-B-385 (Issue #1513, 설계 PR #1515 §4 L3): 원본 증적 형식은 저장소 밖 출력 ───
# 확장자 단위 무시 — 폴더 전체 무시 아님 (요약 .md는 보호, 대상: ..._Result 폴더류 + screenshots)
docs/99_Manual/*_Result/**/*.png
docs/99_Manual/*_Result/**/*.json
docs/99_Manual/*_Result/**/*.xlsx
docs/99_Manual/*_Result/**/*.pdf
docs/99_Manual/*_Result/**/*.txt
docs/99_Manual/*_Result/**/*.webm
tests/e2e/screenshots/**/*.png
tests/e2e/screenshots/**/*.json
tests/e2e/screenshots/**/*.xlsx
tests/e2e/screenshots/**/*.pdf
tests/e2e/screenshots/**/*.txt
tests/e2e/screenshots/**/*.webm
# 예외 패턴: 저장소에 두는 허용 파일이 생기면 여기에 (!) 로 명시한다 (요약 문서류)
!docs/99_Manual/*_Result/**/*.md
!docs/99_Manual/*_Result/**/summary*
!docs/99_Manual/*_Result/**/README*
